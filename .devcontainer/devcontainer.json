{
  "name": "incident-platform AI factory",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW",
    "--add-host=host.docker.internal:host-gateway"
  ],
  "remoteUser": "dev",
  // The container's main process runs as root; you and the agents work as `dev` (remoteUser). The
  // docker-outside-of-docker feature's start script (docker-init.sh) needs root to proxy the host's Docker
  // socket (root:root, 660 on Docker Desktop) to one `dev` may use. Run as `dev`, it calls sudo, which
  // the Dockerfile allows `dev` only for init-firewall.sh, and the proxy never starts: no Docker for
  // Testcontainers. Widening sudo (tee, rm, socat) would give `dev` root in a second way: Docker access
  // already is root over this container (`docker exec -u 0` into it works), so code an agent runs can
  // drop the firewall. Accepted for shadow mode, to be closed before auto-merge: backlog #0-116.
  // Enter with `devcontainer exec`: a plain `docker exec` without `-u dev` lands as root.
  "containerUser": "root",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "workspaceFolder": "/workspace",
  "mounts": [
    "source=incident-platform-claude,target=/home/dev/.claude,type=volume",
    "source=incident-platform-gh,target=/home/dev/.config/gh,type=volume",
    "source=incident-platform-m2,target=/home/dev/.m2,type=volume"
  ],
  "containerEnv": {
    // Every commit made in this container is the machine account's (#0-113), whoever types it: the
    // variables win over any user.name/user.email, including a .gitconfig an IDE copies in from the host,
    // and a rebuild keeps them. The address is the account's GitHub noreply one, so no real mailbox
    // reaches the public history. Pushing as the bot is gh's login (a token in the gh volume).
    "GIT_AUTHOR_NAME": "lukaszplawiakbot",
    "GIT_AUTHOR_EMAIL": "340222835+lukaszplawiakbot@users.noreply.github.com",
    "GIT_COMMITTER_NAME": "lukaszplawiakbot",
    "GIT_COMMITTER_EMAIL": "340222835+lukaszplawiakbot@users.noreply.github.com",
    "TESTCONTAINERS_HOST_OVERRIDE": "host.docker.internal",
    "TESTCONTAINERS_RYUK_DISABLED": "false",
    "OLLAMA_URL": "http://host.docker.internal:11434",
    "FACTORY_BASE_REF": "origin/main",
    "FACTORY_NTFY_TOPIC": "${localEnv:FACTORY_NTFY_TOPIC}",
    "FACTORY_NTFY_SERVER": "${localEnv:FACTORY_NTFY_SERVER}"
  },
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh ${FACTORY_NTFY_TOPIC:+$(echo ${FACTORY_NTFY_SERVER:-https://ntfy.sh} | sed -E 's#^https?://##; s#/.*##')}",
  "hostRequirements": {
    "memory": "16gb"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    }
  }
}
