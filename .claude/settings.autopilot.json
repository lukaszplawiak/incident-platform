{
  "$comment": "Added on top of .claude/settings.json for unattended autopilot sessions only: claude --settings .claude/settings.autopilot.json, then /backlog-autopilot. dontAsk: anything not allowed below is denied, nobody is there to approve it. Deny wins over allow. Paths use ./ (relative to the session's working directory, the repository root): a leading / would be relative to this file's directory. Human-owned paths cannot be written, and nothing outside the repository can be written with the file tools (hook guard-write-in-repo.sh); the network tools are off for every agent but the verifier (an agent that reads untrusted text must not be able to send data out): WebSearch is denied, and WebFetch is allowed for the allow-listed hosts below only so that `dontAsk` runs what the hook webfetch-allowlist.sh passed: the verifier agent only, https only, host and path prefix on its list, no query string, and the verifier reads only the gate's files in .ai/runs/ (read-scope.sh --agent verifier --name …) (backlog #0-160, ADR-0037; a bare WebFetch deny would remove the tool for the verifier too, and a domain rule alone matches the host for every agent); verification cannot be skipped (hooks). Every hook entry says \"onFailure\": \"block\", so a hook that cannot start, crashes or times out refuses the call instead of letting it through (backlog #0-162, ADR-0039; Claude Code 2.1.295 or newer, an older one ignores the field; Factory guards checks every entry, check-hook-entries.rb). Each agent's guard (readonly-bash.sh, write-scope.sh, factory-ops-bash.sh, read-scope.sh) runs in its frontmatter and again here as `--agent <names>`, keyed on agent_type: frontmatter hooks are not promised to a Workflow's agents (backlog #0-164, ADR-0041; check-hook-entries.rb keeps the two equal). `gh pr merge` stays denied until phase 3 (after backlog #0-116; #0-113, the bot account and the ruleset of main, is done): that is what makes shadow mode structural rather than a prompt. A `human:*` label is the owner's word to the audits (backlog #0-126): its deny rules here are a plain-text second line, the hook guard-protected-bash.sh (gh_label_unsafe) is the check that parses every form. They match `human:` anywhere in the command, a title included: an item whose PR title would name a human:* label is refused at ship and stops BLOCKED, for the owner to ship. Phase 3 (docs/ai-factory.md): remove `Bash(gh pr merge *)` from deny, keep the `--admin` deny, and add `Bash(gh pr merge * --squash --auto)` to allow.",
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Workflow(backlog-autopilot)",
      "Workflow(audit)",
      "Workflow(docs-audit)",
      "Workflow(seed-bugs)",
      "Bash(./mvnw *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git merge-base *)",
      "Bash(git ls-files *)",
      "Bash(git blame *)",
      "Bash(git grep *)",
      "Bash(git branch --list *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git fetch origin main)",
      "Bash(git push -u origin *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr ready *)",
      "Bash(gh pr diff *)",
      "Bash(gh issue view *)",
      "Bash(gh run view *)",
      "Bash(gh issue list *)",
      "Bash(gh run list *)",
      "Bash(gh label list *)",
      "Bash(scripts/factory/*)",
      "Bash(./scripts/factory/*)",
      "Bash(ls *)",
      "Bash(mkdir -p .ai/work/*)",
      "Bash(mkdir -p .ai/runs/*)",
      "Bash(cp -r .ai/work/_template *)",
      "Bash(jar tf *)",
      "Bash(kubectl kustomize *)",
      "Bash(kubeconform *)",
      "WebFetch(domain:api.osv.dev)",
      "WebFetch(domain:osv.dev)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:repo1.maven.org)",
      "WebFetch(domain:tomcat.apache.org)",
      "WebFetch(domain:spring.io)"
    ],
    "deny": [
      "Edit(./.ai/rules/**)",
      "Write(./.ai/rules/**)",
      "Edit(./.claude/**)",
      "Write(./.claude/**)",
      "Edit(./.github/**)",
      "Write(./.github/**)",
      "Edit(./architecture-tests/**)",
      "Write(./architecture-tests/**)",
      "Edit(./AGENTS.md)",
      "Write(./AGENTS.md)",
      "Edit(./scripts/factory/**)",
      "Write(./scripts/factory/**)",
      "Edit(./scripts/factory-admin/**)",
      "Edit(./.ai/plan/**)",
      "Write(./.ai/plan/**)",
      "Write(./scripts/factory-admin/**)",
      "Edit(./.devcontainer/**)",
      "Write(./.devcontainer/**)",
      "Edit(./mvnw)",
      "Write(./mvnw)",
      "Edit(./mvnw.cmd)",
      "Write(./mvnw.cmd)",
      "Edit(./.mvn/**)",
      "Write(./.mvn/**)",
      "Edit(./.ruby-version)",
      "Write(./.ruby-version)",
      "Edit(./.git/**)",
      "Write(./.git/**)",
      "Edit(./.ai/runs/LOCK)",
      "Write(./.ai/runs/LOCK)",
      "Edit(./.ai/runs/state.json)",
      "Write(./.ai/runs/state.json)",
      "Edit(./.ai/STOP)",
      "Write(./.ai/STOP)",
      "Edit(./.ai/audit/decisions.md)",
      "Write(./.ai/audit/decisions.md)",
      "Read(**/application-local.yml)",
      "Read(**/application-local.yaml)",
      "Read(./docker/.env)",
      "Read(./docker/secrets/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.claude.json)",
      "Read(~/.ssh/**)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.m2/settings*.xml)",
      "WebSearch",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push origin main *)",
      "Bash(git push origin HEAD:main *)",
      "Bash(git reset --hard *)",
      "Bash(git rebase *)",
      "Bash(git config *)",
      "Bash(gh pr merge * --admin *)",
      "Bash(gh api *)",
      "Bash(gh pr edit *human:*)",
      "Bash(gh pr create *human:*)",
      "Bash(gh issue edit *)",
      "Bash(gh repo *)",
      "Bash(gh secret *)",
      "Bash(gh auth *)",
      "Bash(scripts/factory-admin/*)",
      "Bash(./scripts/factory-admin/*)",
      "Bash(rm -rf *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(docker *)",
      "Bash(sudo *)",
      "Bash(git push -u origin main*)",
      "Bash(git push * HEAD:main*)",
      "Bash(git push * main)",
      "Bash(gh pr merge *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-tests.sh",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-protected-bash.sh",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-git-push.sh",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-factory-scripts.sh",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/webfetch-allowlist.sh",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/read-scope.sh --agent verifier --name 'gate-r*.json' --name 'dependency-tree-r*.txt' .ai/runs/",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-write-in-repo.sh",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-migrations.sh",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/readonly-bash.sh --agent acceptance-reviewer,planner,ready-checker,review-architecture,review-docs,review-general,review-migration,review-performance,review-security",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/readonly-bash.sh --agent architect --architect",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/readonly-bash.sh --agent audit-pipeline,audit-reviewers --gh-read",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/readonly-bash.sh --agent review-k8s --k8s",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/factory-ops-bash.sh --agent factory-ops",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/write-scope.sh --agent architect .ai/decisions/ .ai/work/",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/write-scope.sh --agent audit-synthesis .ai/audit/",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/write-scope.sh --agent planner .ai/plan/ BACKLOG.md",
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "env": {
    "FACTORY_AUDIT_EVERY": "10",
    "FACTORY_MAX_BLOCKED": "2",
    "FACTORY_MAX_MERGES_PER_DAY": "5"
  }
}
