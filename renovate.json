{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],

  "timezone": "Europe/Warsaw",

  "schedule": ["every weekend"],

  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "rebaseWhen": "behind-base-branch",

  "minimumReleaseAge": "3 days",

  "labels": ["dependencies"],

  "customManagers": [
    {
      "description": "CI tools pinned in a workflow's or a composite action's env (backlog #0-147, ADR-0033): a `# renovate:` comment, then <NAME>_VERSION (a release tag) and <NAME>_SHA256. Renovate bumps the tag and computes the new SHA-256 from the release asset that had the old one; .github/scripts/check-pinned-tools.sh then checks it against the publisher (the comment's verify=).",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/", "/^\\.github/actions/[^/]+/action\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>github-release-attachments) depName=(?<depName>\\S+) verify=\\S+\\s+[A-Z0-9_]+_VERSION: (?<currentValue>\\S+)\\s+[A-Z0-9_]+_SHA256: (?<currentDigest>[0-9a-f]{64})"
      ]
    }
  ],

  "packageRules": [
    {
      "description": "Spring Boot — group all Spring updates into one PR",
      "groupName": "Spring Framework",
      "minimumReleaseAge": "7 days",
      "matchPackageNames": [
        "/^org.springframework/"
      ]
    },
    {
      "description": "Spring Boot parent — extra caution, wait 7 days",
      "matchPackageNames": ["org.springframework.boot:spring-boot-starter-parent"],
      "groupName": "Spring Boot",
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Kafka — group Kafka client and streams together",
      "groupName": "Apache Kafka",
      "matchPackageNames": [
        "/^org.apache.kafka/"
      ]
    },
    {
      "description": "Testcontainers — group all testcontainers modules",
      "groupName": "Testcontainers",
      "matchPackageNames": [
        "/^org.testcontainers/"
      ]
    },
    {
      "description": "AWS / GCP SDKs — major versions require manual review",
      "minimumReleaseAge": "14 days",
      "labels": ["dependencies", "needs-review"],
      "matchPackageNames": [
        "/^com.google.cloud/",
        "/^software.amazon/"
      ]
    },
    {
      "description": "GitHub Actions — group updates; the SHA pins and their version comments come from helpers:pinGitHubActionDigests (backlog #0-60)",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "CI tools pinned in workflows (backlog #0-147): one PR per tool, after a week; a bump is trusted only once lint-workflows' check-pinned-tools.sh passes",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["github-release-attachments"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Docker base images — group all Dockerfile updates",
      "matchManagers": ["dockerfile"],
      "groupName": "Docker base images",
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Patch and minor updates — auto-merge when CI passes",
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": false,
      "matchPackageNames": [
        "*"
      ]
    },
    {
      "description": "Major updates — always require manual review",
      "matchUpdateTypes": ["major"],
      "labels": ["dependencies", "major-update"],
      "automerge": false
    }
  ],

  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security", "dependencies"]
  },

  "osvVulnerabilityAlerts": true
}
