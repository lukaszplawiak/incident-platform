# ============================================================
# Incident Platform — environment variables template
# Copy this file to .env and fill in the values.
# .env is git-ignored — never commit it.
#
# Generate JWT_SECRET:      openssl rand -base64 64
# Generate MFA_ENCRYPTION_KEY / SLACK_ENCRYPTION_KEY: openssl rand -base64 32
# ============================================================

# ── Required ─────────────────────────────────────────────────

# Shared JWT secret — MUST be identical across all services.
# Min 64 characters. Generate: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_64

# AES-256-GCM key for encrypting TOTP secrets at rest (auth-service).
# Exactly 32 bytes base64-encoded. Generate: openssl rand -base64 32
MFA_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32

# AES-256-GCM key for encrypting each tenant's Slack bot token at rest
# (auth-service, backlog #0-21) — deliberately separate from
# MFA_ENCRYPTION_KEY. Exactly 32 bytes base64-encoded. Generate: openssl rand -base64 32
SLACK_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32

# PostgreSQL (backlog #0-78, docs/database-roles.md). Both are required:
# docker compose refuses to start without them.
# DB_PASSWORD: password of incident_app, the role every service connects as
# (not a superuser). It replaced POSTGRES_PASSWORD; an .env from before
# #0-78 must rename that line. POSTGRES_ADMIN_PASSWORD: password of the
# image's superuser 'postgres', for administration only. Both are applied
# only when the postgres_data volume is first created; changing them later
# is described in docs/database-roles.md. Dev-only values below: on any host
# other people can reach, change them first, since compose publishes Postgres
# on every interface (backlog #0-72) and the admin is a superuser.
DB_PASSWORD=incident_secret
POSTGRES_ADMIN_PASSWORD=postgres_admin_dev

# Grafana's admin password (backlog #0-94 step 2): required, and deliberately
# empty here: compose refuses every command (even one that does not start
# Grafana) until you set your own. Grafana reads every tenant's logs from Loki,
# so no value from this public template may become its password; it is also
# published on 127.0.0.1 only. Applied only when the grafana_data volume is
# first created; to change it later (or for a volume from before this change,
# whose password is still admin):
#   docker exec incident-grafana grafana cli admin reset-admin-password '<new>'
# At least 16 characters (`make dev-up` warns about a shorter one; compose
# refuses only an empty one). Generate: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=

# ── Optional — override defaults ─────────────────────────────

# JWT token TTLs (ISO-8601 duration)
JWT_ACCESS_TOKEN_TTL=PT15M
JWT_REFRESH_TOKEN_TTL=P30D
JWT_SERVICE_TOKEN_TTL=PT1H

# CORS — Angular/React dev server
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# Backlog #0-16/#0-49: first admin of the reserved platform-operator tenant, which
# receives the platform's own alerts as incidents. auth-service invites this
# address ~30 s after startup and re-invites it if that invite is lost or
# expires (hourly check); the invite lands in mailpit (http://localhost:8025).
OPERATOR_ADMIN_EMAIL=ops@incident-platform.local

# Application base URL (used in invite emails)
APP_BASE_URL=http://localhost:8087

# ── Mail (SMTP) ───────────────────────────────────────────────
# For local dev, use Mailpit (included in docker-compose.yml, backlog #0-16):
#   http://localhost:8025 — Mailpit UI (invites, operator emails)
# For production, set real SMTP credentials.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
INVITE_EMAIL_FROM=noreply@incident-platform.local
NOTIFICATION_OPERATOR_ALERT_EMAIL=operator@incident-platform.local

# ── Slack (optional) ─────────────────────────────────────────
# SLACK_BOT_TOKEN is gone (backlog #0-21) — each tenant installs its own
# workspace's bot token via POST /api/v1/slack-workspace (see README), not
# a platform-wide env var. SLACK_SIGNING_SECRET stays here: it verifies
# every workspace's callbacks (one Slack App, per Slack's own docs).
SLACK_SIGNING_SECRET=

# ── AI / Postmortem generation (optional) ────────────────────
GEMINI_API_KEY=

# ── Service ports (optional — override defaults) ─────────────
AUTH_SERVICE_PORT=8087
INGESTION_SERVICE_PORT=8081
INCIDENT_SERVICE_PORT=8082
NOTIFICATION_SERVICE_PORT=8083
ESCALATION_SERVICE_PORT=8084
POSTMORTEM_SERVICE_PORT=8085
ONCALL_SERVICE_PORT=8086
